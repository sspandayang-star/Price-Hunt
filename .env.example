# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Required: the password you type to open the app.
APP_PASSWORD=

# Required: reads and scores listings. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_QUICK_MODEL=claude-haiku-5-5

# Required: web search. Get one at https://platform.parallel.ai
PARALLEL_API_KEY=

# Saved searches and price watches. Adding Upstash Redis from the Vercel
# Marketplace fills these in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Required for the daily price check. Any long random string.
CRON_SECRET=

# Optional: phone notifications for price drops via the free ntfy app.
# Pick a long, hard-to-guess topic name and subscribe to it in the app.
NTFY_TOPIC=
